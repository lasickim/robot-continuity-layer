{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-observation-series",
  "title": "RCL Repeated Intent Observation Series v0.1",
  "$defs": {
    "intent_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "behavior_id", "trigger", "trigger_state", "success_condition", "success_state"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "behavior_id": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "trigger_state": {"type": "string", "enum": ["observed", "not_observed"]},
        "success_condition": {"type": "string", "minLength": 1},
        "success_state": {"type": "string", "enum": ["satisfied", "not_satisfied", "not_observable"]},
        "strategy_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_observation_series_version", "series_id", "robot_id", "embodiment_id", "sessions"],
  "properties": {
    "intent_observation_series_version": {"const": "0.1"},
    "series_id": {"type": "string", "minLength": 1},
    "robot_id": {"type": "string", "minLength": 1},
    "embodiment_id": {"type": "string", "minLength": 1},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "started_at", "trials"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "trials": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trial_id", "captured_at", "intent_observations"],
              "properties": {
                "trial_id": {"type": "string", "minLength": 1},
                "captured_at": {"type": "string", "format": "date-time"},
                "intent_observations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/intent_observation"}
                }
              }
            }
          }
        }
      }
    }
  }
}
