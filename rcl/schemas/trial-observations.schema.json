{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.3:trial-observations",
  "title": "RCL Repeated-Trial Observations v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_observation_version", "robot_id", "embodiment_id", "captured_at", "behavior_trials"],
  "properties": {
    "trial_observation_version": {"const": "0.1"},
    "robot_id": {"type": "string", "minLength": 1},
    "embodiment_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "behavior_trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "metrics"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
