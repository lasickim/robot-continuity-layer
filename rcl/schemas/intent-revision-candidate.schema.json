{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-revision-candidate",
  "title": "RCL Intent Revision Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_candidate_version",
    "candidate_id",
    "created_at",
    "behavior_id",
    "current_intent_sha256",
    "replacement_intent",
    "reason",
    "evidence_refs",
    "causal_claim"
  ],
  "properties": {
    "revision_candidate_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "behavior_id": {"type": "string", "minLength": 1},
    "current_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replacement_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "trigger", "success_condition", "failure_action", "criticality", "required_capabilities"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "success_condition": {"type": "string", "minLength": 1},
        "failure_action": {"type": "string", "enum": ["block", "retry", "request_help", "abort", "degrade_safely"]},
        "criticality": {"type": "string", "enum": ["required", "preferred", "advisory"]},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "proposed_by": {"type": ["string", "null"]},
    "causal_claim": {"const": false}
  }
}
