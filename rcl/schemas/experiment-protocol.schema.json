{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.3:experiment-protocol",
  "title": "RCL Experiment Protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_version"],
  "properties": {
    "protocol_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "comparison_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["task_id", "environment_id", "subject_ref", "operator_ref", "start_condition_id"]
      }
    },
    "description": {"type": "string"}
  }
}
