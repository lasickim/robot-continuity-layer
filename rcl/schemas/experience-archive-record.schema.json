{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:experience-archive-record",
  "title": "RCL Experience Archive Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archive_version",
    "method",
    "archive_id",
    "archived_at",
    "archived_by",
    "location_ref",
    "source",
    "episode_count",
    "episode_ids",
    "episode_id_digest_sha256",
    "archive_assertion",
    "non_mutating",
    "archive_executed_by_rcl",
    "disclaimer"
  ],
  "properties": {
    "archive_version": {"const": "0.1"},
    "method": {"const": "rcl.experience.archive.record.v0.1"},
    "archive_id": {"type": "string", "pattern": "^experience-archive-[0-9a-f]{16}$"},
    "archived_at": {"type": "string", "format": "date-time"},
    "archived_by": {"type": "string", "minLength": 1},
    "location_ref": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "source_digest_sha256"],
      "properties": {
        "store_id": {"type": "string", "minLength": 1},
        "source_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "episode_count": {"type": "integer", "minimum": 1},
    "episode_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "episode_id_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_assertion": {"const": "deployment_asserted_external_copy"},
    "non_mutating": {"const": true},
    "archive_executed_by_rcl": {"const": false},
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
