{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:observed-intent-success-report",
  "title": "RCL Observed Intent Success Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_version", "method", "created_at", "declared_profile", "observed_subject", "status", "evaluation_success", "required_failures", "required_inconclusive", "nonblocking_failures", "intent_results", "disclaimer"],
  "properties": {
    "evaluation_version": {"const": "0.1"},
    "method": {"const": "rcl.observed.intent_success.v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "declared_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["robot_id", "embodiment_id"],
      "properties": {"robot_id": {"type": "string", "minLength": 1}, "embodiment_id": {"type": "string", "minLength": 1}}
    },
    "observed_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["robot_id", "embodiment_id", "captured_at"],
      "properties": {"robot_id": {"type": "string", "minLength": 1}, "embodiment_id": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "format": "date-time"}}
    },
    "status": {"type": "string", "enum": ["passed", "failed", "inconclusive"]},
    "evaluation_success": {"type": ["boolean", "null"]},
    "required_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_inconclusive": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonblocking_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "intent_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["behavior_id", "goal_id", "criticality", "trigger", "success_condition", "observation_present", "observation_id", "trigger_state", "success_state", "strategy_id", "evidence_refs", "status", "blocking", "reason"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "goal_id": {"type": "string", "minLength": 1},
          "criticality": {"type": "string", "enum": ["required", "preferred", "advisory"]},
          "trigger": {"type": "string", "minLength": 1},
          "success_condition": {"type": "string", "minLength": 1},
          "observation_present": {"type": "boolean"},
          "observation_id": {"type": ["string", "null"]},
          "trigger_state": {"type": ["string", "null"], "enum": ["observed", "not_observed", null]},
          "success_state": {"type": ["string", "null"], "enum": ["satisfied", "not_satisfied", "not_observable", null]},
          "strategy_id": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["pass", "fail", "not_observable", "not_triggered"]},
          "blocking": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
