{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.5:continuity-score-report",
  "title": "RCL Continuity Score Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continuity_score_version",
    "created_at",
    "source_robot_id",
    "source_profile_id",
    "constraint_set_id",
    "target_robot_id",
    "target_embodiment_id",
    "trait_scores",
    "summary"
  ],
  "properties": {
    "continuity_score_version": {"const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_robot_id": {"type": "string", "minLength": 1},
    "source_profile_id": {"type": "string", "minLength": 1},
    "constraint_set_id": {"type": "string", "minLength": 1},
    "target_robot_id": {"type": "string", "minLength": 1},
    "target_embodiment_id": {"type": "string", "minLength": 1},
    "trait_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "behavior_id",
          "dimension",
          "classification",
          "importance",
          "source_confidence",
          "effective_weight",
          "preservation_mode",
          "constraint_satisfied",
          "fidelity_lower",
          "fidelity_upper"
        ],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1},
          "behavior_id": {"type": "string", "minLength": 1},
          "dimension": {"type": "string", "minLength": 1},
          "classification": {"enum": ["EXACT", "APPROXIMATE", "SUBSTITUTE", "UNSUPPORTED"]},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "source_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "effective_weight": {"type": "number", "minimum": 0},
          "preservation_mode": {"enum": ["preference", "characteristic", "identity_critical"]},
          "constraint_satisfied": {"type": "boolean"},
          "fidelity": {"type": "number", "minimum": 0, "maximum": 1},
          "fidelity_lower": {"type": "number", "minimum": 0, "maximum": 1},
          "fidelity_upper": {"type": "number", "minimum": 0, "maximum": 1},
          "assessment_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_bound",
        "upper_bound",
        "policy_coverage_score",
        "resolved_weight_fraction",
        "identity_critical_ok",
        "identity_critical_failures"
      ],
      "properties": {
        "lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "upper_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "resolved_score": {"type": "number", "minimum": 0, "maximum": 1},
        "policy_coverage_score": {"type": "number", "minimum": 0, "maximum": 1},
        "resolved_weight_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_critical_ok": {"type": "boolean"},
        "identity_critical_failures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
