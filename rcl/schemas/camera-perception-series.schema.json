{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.5:camera-perception-series",
  "title": "RCL Camera Perception Series v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera_perception_series_version", "series_id", "robot_id", "sensor_component_id", "model", "sessions"],
  "properties": {
    "camera_perception_series_version": {"const": "0.1"},
    "series_id": {"type": "string", "minLength": 1},
    "robot_id": {"type": "string", "minLength": 1},
    "sensor_component_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "runtime"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sessions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "started_at", "trials"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "trials": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["trial_id", "captured_at", "frame_ref", "inferences"],
              "properties": {
                "trial_id": {"type": "string", "minLength": 1},
                "captured_at": {"type": "string", "format": "date-time"},
                "frame_ref": {"type": "string", "minLength": 1},
                "inferences": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["inference_id", "semantic_state", "predicate", "confidence"],
                    "properties": {
                      "inference_id": {"type": "string", "minLength": 1},
                      "semantic_state": {"type": "string", "minLength": 1},
                      "predicate": {"type": "boolean"},
                      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                      "strategy_id": {"type": "string", "minLength": 1},
                      "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
