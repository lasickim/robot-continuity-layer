{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:behavior",
  "title": "RCL Behavior v0.4-dev with intent capability paths, expression history/timing, revision, evaluation, and habit metadata",
  "$defs": {
    "capability_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id"],
      "properties": {
        "path_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
        "description": {"type": "string", "minLength": 1},
        "all_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "any_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "one_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "anyOf": [
        {"required": ["all_of"]},
        {"required": ["any_of"]},
        {"required": ["one_of"]}
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "trigger", "success_condition", "failure_action", "criticality"],
      "oneOf": [
        {"required": ["required_capabilities"], "not": {"required": ["capability_paths"]}},
        {"required": ["capability_paths"], "not": {"required": ["required_capabilities"]}}
      ],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^(?:[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+|x\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z][a-z0-9_]*)+)$"},
        "description": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "success_condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "failure_action": {"type": "string", "enum": ["block", "retry", "request_help", "abort", "degrade_safely"]},
        "criticality": {"type": "string", "enum": ["required", "preferred", "advisory"]},
        "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "capability_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability_path"}},
        "constraints": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"}, "uniqueItems": true},
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "candidate_id", "dataset_id", "discovery_method", "policy_id", "policy_version", "candidate_report_sha256", "approved_at", "approved_by", "causal_claim"],
              "properties": {
                "source": {"const": "discovered"},
                "candidate_id": {"type": "string", "minLength": 1},
                "dataset_id": {"type": "string", "minLength": 1},
                "discovery_method": {"const": "rcl.intent.discovery.context_action_outcome.v0.1"},
                "policy_id": {"type": "string", "minLength": 1},
                "policy_version": {"const": "0.1"},
                "candidate_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "approved_at": {"type": "string", "format": "date-time"},
                "approved_by": {"type": ["string", "null"]},
                "causal_claim": {"const": false}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "revision_id", "revision_candidate_id", "revision_candidate_sha256", "previous_intent_sha256", "reason", "evidence_refs", "approved_at", "approved_by", "causal_claim"],
              "properties": {
                "source": {"const": "revised"},
                "revision_id": {"type": "string", "minLength": 1},
                "revision_candidate_id": {"type": "string", "minLength": 1},
                "revision_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "previous_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reason": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "approved_at": {"type": "string", "format": "date-time"},
                "approved_by": {"type": ["string", "null"]},
                "causal_claim": {"const": false}
              }
            }
          ]
        }
      }
    },
    "temporal_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempo", "dwell", "transition", "timing_policy", "legacy_significance"],
      "properties": {
        "tempo": {"type": "string", "enum": ["deliberate", "relaxed", "natural", "quick"]},
        "dwell": {"type": "string", "enum": ["none", "brief", "natural", "held"]},
        "transition": {"type": "string", "enum": ["gentle", "smooth", "direct", "crisp"]},
        "timing_policy": {"type": "string", "enum": ["naturalize", "preserve_style"]},
        "legacy_significance": {"type": "string", "enum": ["incidental", "recognized", "user_valued"]},
        "source_timing_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion_duration_ms", "dwell_duration_ms", "return_duration_ms", "normative"],
          "properties": {
            "motion_duration_ms": {"type": "number", "exclusiveMinimum": 0},
            "dwell_duration_ms": {"type": "number", "minimum": 0},
            "return_duration_ms": {"type": "number", "exclusiveMinimum": 0},
            "normative": {"const": false}
          }
        },
        "source_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "effect"],
            "properties": {
              "artifact": {"type": "string", "enum": ["actuator_speed_limit", "gearing_limit", "wiring_constraint", "controller_latency", "power_limit", "unknown_hardware_constraint"]},
              "effect": {"type": "string", "enum": ["slower_than_intended", "delayed_start", "uneven_motion"]}
            }
          }
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression_id", "preservation_priority", "required_capabilities"],
      "properties": {
        "expression_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "description": {"type": "string", "minLength": 1},
        "preservation_priority": {"type": "string", "enum": ["preferred", "optional"]},
        "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "temporal_style": {"$ref": "#/$defs/temporal_style"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["behaviors"],
  "properties": {
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "parameters", "preservation"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "parameters": {"type": "object"},
          "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "intent": {"$ref": "#/$defs/intent"},
          "intent_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision_id", "revised_at", "revised_by", "candidate_id", "candidate_sha256", "reason", "evidence_refs", "from_intent_sha256", "to_intent_sha256", "intent_snapshot", "causal_claim"],
              "properties": {
                "revision_id": {"type": "string", "minLength": 1},
                "revised_at": {"type": "string", "format": "date-time"},
                "revised_by": {"type": ["string", "null"]},
                "candidate_id": {"type": "string", "minLength": 1},
                "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reason": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "from_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "to_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "intent_snapshot": {"type": "object"},
                "causal_claim": {"const": false}
              }
            }
          },
          "expression": {"$ref": "#/$defs/expression"},
          "expression_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["optimization_id", "optimized_at", "optimized_by", "action", "candidate_id", "candidate_sha256", "reason", "evidence_refs", "from_expression_sha256", "to_expression_sha256", "expression_snapshot"],
              "properties": {
                "optimization_id": {"type": "string", "minLength": 1},
                "optimized_at": {"type": "string", "format": "date-time"},
                "optimized_by": {"type": ["string", "null"]},
                "action": {"type": "string", "enum": ["simplify", "remove"]},
                "candidate_id": {"type": "string", "minLength": 1},
                "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reason": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "from_expression_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "to_expression_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "expression_snapshot": {"$ref": "#/$defs/expression"}
              }
            }
          },
          "preservation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priority", "mode"],
            "properties": {
              "priority": {"type": "string", "enum": ["required", "preferred", "optional"]},
              "mode": {"type": "string", "enum": ["semantic", "legacy"]}
            }
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metrics"],
            "properties": {
              "metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric_id", "observable", "target_parameter", "unit", "tolerance", "zero_credit_at", "weight"],
                  "properties": {
                    "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "observable": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "target_parameter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "unit": {"type": "string", "minLength": 1},
                    "tolerance": {"type": "number", "minimum": 0},
                    "zero_credit_at": {"type": "number", "exclusiveMinimum": 0},
                    "weight": {"type": "number", "exclusiveMinimum": 0},
                    "required": {"type": "boolean", "default": true},
                    "min_trials": {"type": "integer", "minimum": 2, "default": 5}
                  }
                }
              }
            }
          },
          "habit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lifecycle", "first_observed_at", "events"],
            "properties": {
              "lifecycle": {"type": "string", "enum": ["configured", "learning", "stable", "legacy"]},
              "first_observed_at": {"type": "string", "format": "date-time"},
              "stable_since": {"type": "string", "format": "date-time"},
              "legacy_since": {"type": "string", "format": "date-time"},
              "user_confirmed_at": {"type": "string", "format": "date-time"},
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["event_id", "observed_at", "event_type"],
                  "properties": {
                    "event_id": {"type": "string", "minLength": 1},
                    "observed_at": {"type": "string", "format": "date-time"},
                    "event_type": {"type": "string", "enum": ["configured", "observed", "learned_update", "stabilized", "legacy_promoted", "user_confirmed", "promotion_approved", "note"]},
                    "parameter_values": {"type": "object"},
                    "note": {"type": "string"},
                    "evidence_ref": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "source": {"type": "string", "enum": ["configured", "learned", "imported"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
