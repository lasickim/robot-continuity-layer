{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.2:behavior",
  "title": "RCL Behavior v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["behaviors"],
  "properties": {
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "parameters", "preservation"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "parameters": {"type": "object"},
          "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "preservation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priority", "mode"],
            "properties": {
              "priority": {"type": "string", "enum": ["required", "preferred", "optional"]},
              "mode": {"type": "string", "enum": ["semantic", "legacy"]}
            }
          },
          "source": {"type": "string", "enum": ["configured", "learned", "imported"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
