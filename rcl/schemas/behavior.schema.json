{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.2:behavior",
  "title": "RCL Behavior v0.2 with v0.3-dev evaluation and habit metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["behaviors"],
  "properties": {
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_id", "parameters", "preservation"],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "parameters": {"type": "object"},
          "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "preservation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priority", "mode"],
            "properties": {
              "priority": {"type": "string", "enum": ["required", "preferred", "optional"]},
              "mode": {"type": "string", "enum": ["semantic", "legacy"]}
            }
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metrics"],
            "properties": {
              "metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric_id", "observable", "target_parameter", "unit", "tolerance", "zero_credit_at", "weight"],
                  "properties": {
                    "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "observable": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "target_parameter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "unit": {"type": "string", "minLength": 1},
                    "tolerance": {"type": "number", "minimum": 0},
                    "zero_credit_at": {"type": "number", "exclusiveMinimum": 0},
                    "weight": {"type": "number", "exclusiveMinimum": 0},
                    "required": {"type": "boolean", "default": true},
                    "min_trials": {"type": "integer", "minimum": 2, "default": 5}
                  }
                }
              }
            }
          },
          "habit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lifecycle", "first_observed_at", "events"],
            "properties": {
              "lifecycle": {"type": "string", "enum": ["configured", "learning", "stable", "legacy"]},
              "first_observed_at": {"type": "string", "format": "date-time"},
              "stable_since": {"type": "string", "format": "date-time"},
              "legacy_since": {"type": "string", "format": "date-time"},
              "user_confirmed_at": {"type": "string", "format": "date-time"},
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["event_id", "observed_at", "event_type"],
                  "properties": {
                    "event_id": {"type": "string", "minLength": 1},
                    "observed_at": {"type": "string", "format": "date-time"},
                    "event_type": {"type": "string", "enum": ["configured", "observed", "learned_update", "stabilized", "legacy_promoted", "user_confirmed", "note"]},
                    "parameter_values": {"type": "object"},
                    "note": {"type": "string"},
                    "evidence_ref": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "source": {"type": "string", "enum": ["configured", "learned", "imported"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
