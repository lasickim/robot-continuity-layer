{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:experience-retention-policy",
  "title": "RCL Experience Retention Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_version",
    "min_active_retention_days",
    "protect_retained_exemplars",
    "protect_external_evidence_refs",
    "min_group_episode_count_for_prune",
    "max_prune_fraction_per_group",
    "require_archive_record_for_prune"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"const": "0.1"},
    "min_active_retention_days": {"type": "integer", "minimum": 0},
    "protect_retained_exemplars": {"type": "boolean"},
    "protect_external_evidence_refs": {"type": "boolean"},
    "min_group_episode_count_for_prune": {"type": "integer", "minimum": 2},
    "max_prune_fraction_per_group": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "require_archive_record_for_prune": {"type": "boolean"}
  }
}
