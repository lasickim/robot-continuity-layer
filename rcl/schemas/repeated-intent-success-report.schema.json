{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:repeated-intent-success-report",
  "title": "RCL Repeated Intent Success Report v0.1",
  "$defs": {
    "nullable_rate": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "wilson_interval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "half_width"],
          "properties": {
            "low": {"type": "number", "minimum": 0, "maximum": 1},
            "high": {"type": "number", "minimum": 0, "maximum": 1},
            "half_width": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "session_interval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "half_width", "critical_value"],
          "properties": {
            "low": {"type": "number", "minimum": 0, "maximum": 1},
            "high": {"type": "number", "minimum": 0, "maximum": 1},
            "half_width": {"type": "number", "minimum": 0},
            "critical_value": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repeated_intent_success_version",
    "method",
    "created_at",
    "confidence_level",
    "min_observable_trials",
    "min_sessions",
    "declared_profile",
    "observed_subject",
    "total_session_count",
    "total_trial_count",
    "status",
    "evaluation_success",
    "required_failures",
    "required_inconclusive",
    "nonblocking_failures",
    "nonblocking_inconclusive",
    "session_results",
    "intent_summaries",
    "disclaimer"
  ],
  "properties": {
    "repeated_intent_success_version": {"const": "0.1"},
    "method": {"const": "rcl.observed.intent_success.repeated.v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "confidence_level": {"const": 0.95},
    "min_observable_trials": {"type": "integer", "minimum": 2},
    "min_sessions": {"type": "integer", "minimum": 3},
    "declared_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robot_id", "embodiment_id"],
      "properties": {
        "robot_id": {"type": "string", "minLength": 1},
        "embodiment_id": {"type": "string", "minLength": 1}
      }
    },
    "observed_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "robot_id", "embodiment_id"],
      "properties": {
        "series_id": {"type": "string", "minLength": 1},
        "robot_id": {"type": "string", "minLength": 1},
        "embodiment_id": {"type": "string", "minLength": 1}
      }
    },
    "total_session_count": {"type": "integer", "minimum": 1},
    "total_trial_count": {"type": "integer", "minimum": 2},
    "status": {"type": "string", "enum": ["estimated", "inconclusive", "failed"]},
    "evaluation_success": {"type": ["boolean", "null"]},
    "required_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_inconclusive": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "nonblocking_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "nonblocking_inconclusive": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "session_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id", "started_at", "trial_count", "status", "evaluation_success",
          "required_failures", "required_inconclusive", "nonblocking_failures", "trial_results"
        ],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "trial_count": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["passed", "inconclusive", "failed"]},
          "evaluation_success": {"type": ["boolean", "null"]},
          "required_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "required_inconclusive": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "nonblocking_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "trial_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trial_id", "captured_at", "status", "evaluation_success",
                "required_failures", "required_inconclusive", "nonblocking_failures"
              ],
              "properties": {
                "trial_id": {"type": "string", "minLength": 1},
                "captured_at": {"type": "string", "format": "date-time"},
                "status": {"type": "string", "enum": ["passed", "inconclusive", "failed"]},
                "evaluation_success": {"type": ["boolean", "null"]},
                "required_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "required_inconclusive": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "nonblocking_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "intent_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behavior_id", "goal_id", "criticality", "trigger", "success_condition",
          "pass_count", "fail_count", "not_observable_count", "not_triggered_count",
          "missing_observation_count", "total_trial_count", "triggered_trial_count",
          "observable_trial_count", "observable_rate", "observed_success_rate",
          "wilson_interval_95", "observed_strategy_ids", "session_count",
          "scorable_session_count", "mean_session_success_rate", "session_success_rate_std",
          "session_confidence_interval_95", "status", "blocking", "session_summaries"
        ],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "goal_id": {"type": "string", "minLength": 1},
          "criticality": {"type": "string", "enum": ["required", "preferred", "advisory"]},
          "trigger": {"type": "string", "minLength": 1},
          "success_condition": {"type": "string", "minLength": 1},
          "pass_count": {"type": "integer", "minimum": 0},
          "fail_count": {"type": "integer", "minimum": 0},
          "not_observable_count": {"type": "integer", "minimum": 0},
          "not_triggered_count": {"type": "integer", "minimum": 0},
          "missing_observation_count": {"type": "integer", "minimum": 0},
          "total_trial_count": {"type": "integer", "minimum": 1},
          "triggered_trial_count": {"type": "integer", "minimum": 0},
          "observable_trial_count": {"type": "integer", "minimum": 0},
          "observable_rate": {"$ref": "#/$defs/nullable_rate"},
          "observed_success_rate": {"$ref": "#/$defs/nullable_rate"},
          "wilson_interval_95": {"$ref": "#/$defs/wilson_interval"},
          "observed_strategy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "session_count": {"type": "integer", "minimum": 1},
          "scorable_session_count": {"type": "integer", "minimum": 0},
          "mean_session_success_rate": {"$ref": "#/$defs/nullable_rate"},
          "session_success_rate_std": {"type": ["number", "null"], "minimum": 0},
          "session_confidence_interval_95": {"$ref": "#/$defs/session_interval"},
          "status": {"type": "string", "enum": ["estimated", "insufficient_evidence", "observed_failures"]},
          "blocking": {"type": "boolean"},
          "session_summaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "session_id", "behavior_id", "pass_count", "fail_count",
                "not_observable_count", "not_triggered_count", "missing_observation_count",
                "total_trial_count", "triggered_trial_count", "observable_trial_count",
                "observable_rate", "observed_success_rate", "wilson_interval_95",
                "observed_strategy_ids", "status"
              ],
              "properties": {
                "session_id": {"type": "string", "minLength": 1},
                "behavior_id": {"type": "string", "minLength": 1},
                "pass_count": {"type": "integer", "minimum": 0},
                "fail_count": {"type": "integer", "minimum": 0},
                "not_observable_count": {"type": "integer", "minimum": 0},
                "not_triggered_count": {"type": "integer", "minimum": 0},
                "missing_observation_count": {"type": "integer", "minimum": 0},
                "total_trial_count": {"type": "integer", "minimum": 1},
                "triggered_trial_count": {"type": "integer", "minimum": 0},
                "observable_trial_count": {"type": "integer", "minimum": 0},
                "observable_rate": {"$ref": "#/$defs/nullable_rate"},
                "observed_success_rate": {"$ref": "#/$defs/nullable_rate"},
                "wilson_interval_95": {"$ref": "#/$defs/wilson_interval"},
                "observed_strategy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "status": {"type": "string", "enum": ["observed", "insufficient_evidence", "observed_failures"]}
              }
            }
          }
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
