{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.5:simulation-reference-report",
  "title": "RCL Simulation Reference Experiment Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulation_reference_version",
    "method",
    "created_at",
    "behavior_id",
    "goal_id",
    "source",
    "target",
    "migration",
    "assertions",
    "disclaimer"
  ],
  "properties": {
    "simulation_reference_version": {"const": "0.1"},
    "method": {"const": "rcl.simulation.reference_migration.v0.5"},
    "created_at": {"type": "string", "format": "date-time"},
    "behavior_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/subject"},
    "target": {"$ref": "#/$defs/subject"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_success",
        "behavior_status",
        "intent_status",
        "selected_capability_path_id",
        "target_strategy",
        "expression_status"
      ],
      "properties": {
        "migration_success": {"type": "boolean"},
        "behavior_status": {
          "type": "string",
          "enum": ["preserved", "approximated", "unsupported", "blocked_for_safety"]
        },
        "intent_status": {
          "type": "string",
          "enum": ["preserved", "approximated", "unsupported", "blocked_for_safety"]
        },
        "selected_capability_path_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "target_strategy": {"type": ["string", "null"], "minLength": 1},
        "expression_status": {
          "type": ["string", "null"],
          "enum": ["preserved", "approximated", "unsupported", "blocked_for_safety", null]
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_goal_estimated",
        "target_goal_estimated",
        "migration_success",
        "intent_preserved",
        "target_selected_expected_path",
        "strategies_differ",
        "target_strategy_observed",
        "experiment_passed"
      ],
      "properties": {
        "source_goal_estimated": {"type": "boolean"},
        "target_goal_estimated": {"type": "boolean"},
        "migration_success": {"type": "boolean"},
        "intent_preserved": {"type": "boolean"},
        "target_selected_expected_path": {"type": "boolean"},
        "strategies_differ": {"type": "boolean"},
        "target_strategy_observed": {"type": "boolean"},
        "experiment_passed": {"type": "boolean"}
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot_id",
        "embodiment_id",
        "observed_strategy_ids",
        "repeated_intent_status",
        "observed_success_rate"
      ],
      "properties": {
        "robot_id": {"type": "string", "minLength": 1},
        "embodiment_id": {"type": "string", "minLength": 1},
        "observed_strategy_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "repeated_intent_status": {
          "type": "string",
          "enum": ["estimated", "observed_failures", "insufficient_evidence"]
        },
        "observed_success_rate": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
