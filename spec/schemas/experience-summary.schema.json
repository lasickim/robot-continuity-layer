{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:experience-summary",
  "title": "RCL Experience Summary v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary_version", "method", "created_at", "summary_id", "source", "group_count", "groups", "destructive"],
  "properties": {
    "summary_version": {"const": "0.1"},
    "method": {"const": "rcl.experience.compaction.semantic_groups.v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "summary_id": {"type": "string", "minLength": 1},
    "destructive": {"const": false},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "episode_count", "source_digest_sha256"],
      "properties": {
        "store_id": {"type": "string", "minLength": 1},
        "episode_count": {"type": "integer", "minimum": 1},
        "source_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "group_count": {"type": "integer", "minimum": 1},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "context", "action_id", "outcome_ids", "first_observed_at", "last_observed_at", "episode_count", "action_present_count", "action_absent_count", "outcomes", "provenance"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "context": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "action_id": {"type": "string", "minLength": 1},
          "outcome_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "first_observed_at": {"type": "string", "format": "date-time"},
          "last_observed_at": {"type": "string", "format": "date-time"},
          "episode_count": {"type": "integer", "minimum": 1},
          "action_present_count": {"type": "integer", "minimum": 0},
          "action_absent_count": {"type": "integer", "minimum": 0},
          "outcomes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/$defs/outcomeSummary"}
          },
          "action_strata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["present", "absent"],
            "properties": {
              "present": {"$ref": "#/$defs/actionStratum"},
              "absent": {"$ref": "#/$defs/actionStratum"}
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_episode_count", "source_episode_id_digest_sha256", "retained_exemplar_episode_ids"],
            "properties": {
              "source_episode_count": {"type": "integer", "minimum": 1},
              "source_episode_id_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "retained_exemplar_episode_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "actionStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_count", "outcomes"],
      "properties": {
        "episode_count": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/outcomeSummary"}
        }
      }
    },
    "outcomeSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "mean", "sample_std", "min", "max"],
          "properties": {
            "type": {"const": "numeric"},
            "count": {"type": "integer", "minimum": 1},
            "mean": {"type": "number"},
            "sample_std": {"type": ["number", "null"], "minimum": 0},
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "true_count", "false_count", "true_rate"],
          "properties": {
            "type": {"const": "binary"},
            "count": {"type": "integer", "minimum": 1},
            "true_count": {"type": "integer", "minimum": 0},
            "false_count": {"type": "integer", "minimum": 0},
            "true_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    }
  }
}
