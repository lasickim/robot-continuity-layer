{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.5:sensor-evidence-series",
  "title": "RCL Sensor Evidence Series v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sensor_evidence_series_version", "series_id", "robot_id", "sensor_component_id", "modality", "sessions"],
  "properties": {
    "sensor_evidence_series_version": {"const": "0.1"},
    "series_id": {"type": "string", "minLength": 1},
    "robot_id": {"type": "string", "minLength": 1},
    "sensor_component_id": {"type": "string", "minLength": 1},
    "modality": {"type": "string", "enum": ["distance", "camera", "tactile", "audio", "imu", "other"]},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sessions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "started_at", "trials"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "trials": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["trial_id", "captured_at", "claims"],
              "properties": {
                "trial_id": {"type": "string", "minLength": 1},
                "captured_at": {"type": "string", "format": "date-time"},
                "claims": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["claim_id", "semantic_state", "state"],
                    "properties": {
                      "claim_id": {"type": "string", "minLength": 1},
                      "semantic_state": {"type": "string", "minLength": 1},
                      "state": {"type": "string", "enum": ["satisfied", "not_satisfied", "not_observable"]},
                      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                      "strategy_id": {"type": "string", "minLength": 1},
                      "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
