{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-hypothesis-proposal",
  "title": "RCL Intent Hypothesis Proposal v0.1",
  "$defs": {
    "capability_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id"],
      "properties": {
        "path_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
        "description": {"type": "string", "minLength": 1},
        "all_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "any_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "one_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "anyOf": [
        {"required": ["all_of"]},
        {"required": ["any_of"]},
        {"required": ["one_of"]}
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "trigger", "success_condition", "failure_action", "criticality"],
      "oneOf": [
        {"required": ["required_capabilities"], "not": {"required": ["capability_paths"]}},
        {"required": ["capability_paths"], "not": {"required": ["required_capabilities"]}}
      ],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^(?:[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+|x\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z][a-z0-9_]*)+)$"},
        "description": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "success_condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "failure_action": {"type": "string", "enum": ["block", "retry", "request_help", "abort", "degrade_safely"]},
        "criticality": {"type": "string", "enum": ["required", "preferred", "advisory"]},
        "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "capability_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability_path"}},
        "constraints": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"}, "uniqueItems": true}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_hypothesis_proposal_version",
    "method",
    "proposal_id",
    "created_at",
    "status",
    "non_mutating",
    "approved",
    "proposer",
    "candidate_action_id",
    "context_match",
    "outcome",
    "proposed_intent",
    "rationale_summary",
    "evidence_refs",
    "self_confidence",
    "self_confidence_semantics"
  ],
  "properties": {
    "intent_hypothesis_proposal_version": {"const": "0.1"},
    "method": {"const": "rcl.intent.hypothesis_proposer.v0.1"},
    "proposal_id": {"type": "string", "pattern": "^intent-proposal-[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "proposed"},
    "non_mutating": {"const": true},
    "approved": {"const": false},
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proposer_id"],
      "properties": {
        "kind": {"type": "string", "enum": ["human", "rule_based", "llm", "vlm", "external_model", "other"]},
        "proposer_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "candidate_action_id": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+|x\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z][a-z0-9_]*)+)$"
    },
    "context_match": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "type", "higher_is_better", "minimum_meaningful_effect"],
      "properties": {
        "outcome_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "enum": ["numeric", "binary"]},
        "higher_is_better": {"type": "boolean"},
        "minimum_meaningful_effect": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "proposed_intent": {"$ref": "#/$defs/intent"},
    "rationale_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "self_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "self_confidence_semantics": {"const": "proposer_self_reported_non_normative"}
  }
}
