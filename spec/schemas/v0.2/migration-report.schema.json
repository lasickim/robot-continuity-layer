{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.2:migration-report",
  "title": "RCL Migration Report v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["rcl_version", "report_version", "created_at", "source", "target", "adapter", "behavior_results", "continuity"],
  "properties": {
    "rcl_version": {"const": "0.2"},
    "report_version": {"const": "0.2"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "additionalProperties": false, "required": ["robot_id", "profile_id", "embodiment_id"], "properties": {"robot_id": {"type": "string"}, "profile_id": {"type": ["string", "null"]}, "embodiment_id": {"type": "string"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["embodiment_id", "vendor", "model"], "properties": {"embodiment_id": {"type": "string"}, "vendor": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["adapter_id", "adapter_version"], "properties": {"adapter_id": {"type": "string"}, "adapter_version": {"type": "string"}}},
    "behavior_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["behavior_id", "status", "similarity", "reason", "required_capabilities", "missing_capabilities", "mapped_parameters"], "properties": {"behavior_id": {"type": "string"}, "status": {"type": "string", "enum": ["preserved", "approximated", "unsupported", "blocked_for_safety"]}, "similarity": {"type": "number", "minimum": 0, "maximum": 1}, "reason": {"type": "string"}, "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "missing_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "mapped_parameters": {"type": "object"}}}},
    "continuity": {"type": "object", "additionalProperties": false, "required": ["method", "score", "migration_success", "required_failures", "safety_blocks", "details"], "properties": {"method": {"const": "rcl.behavior.weighted_similarity.v0.2"}, "score": {"type": "number", "minimum": 0, "maximum": 100}, "migration_success": {"type": "boolean"}, "required_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "safety_blocks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "details": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["behavior_id", "priority", "weight", "status", "similarity", "weighted_similarity"], "properties": {"behavior_id": {"type": "string"}, "priority": {"type": "string", "enum": ["required", "preferred", "optional"]}, "weight": {"type": "number", "minimum": 0}, "status": {"type": "string", "enum": ["preserved", "approximated", "unsupported", "blocked_for_safety"]}, "similarity": {"type": "number", "minimum": 0, "maximum": 1}, "weighted_similarity": {"type": "number", "minimum": 0}}}}}}
  }
}
