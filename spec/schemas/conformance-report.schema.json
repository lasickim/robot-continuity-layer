{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.3:conformance-report",
  "title": "RCL Adapter Conformance Report v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["rcl_version", "suite_id", "suite_version", "created_at", "adapter", "passed", "compatibility_level", "groups", "checks", "disclaimer"],
  "properties": {
    "rcl_version": {"type": "string", "const": "0.2"},
    "suite_id": {"type": "string", "const": "rcl.adapter.mobile_base.v0.3"},
    "suite_version": {"type": "string", "const": "0.3"},
    "created_at": {"type": "string", "format": "date-time"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "python_class"],
      "properties": {
        "adapter_id": {"type": "string"},
        "adapter_version": {"type": "string"},
        "python_class": {"type": "string", "minLength": 1}
      }
    },
    "passed": {"type": "boolean"},
    "compatibility_level": {"type": ["string", "null"], "enum": ["RCL Migration Compatible", null]},
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Profile", "Adapter", "Migration", "Safety", "Reporting"],
      "properties": {
        "Profile": {"type": "boolean"},
        "Adapter": {"type": "boolean"},
        "Migration": {"type": "boolean"},
        "Safety": {"type": "boolean"},
        "Reporting": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "check_id", "passed", "message"],
        "properties": {
          "group": {"type": "string", "enum": ["Profile", "Adapter", "Migration", "Safety", "Reporting"]},
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "message": {"type": "string"}
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
