{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.3:capability-registry",
  "title": "RCL Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "status", "reserved_namespaces", "extension_prefix", "capabilities"],
  "properties": {
    "registry_id": {"const": "rcl.capability-registry"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["experimental", "stable", "deprecated"]},
    "reserved_namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "summary"],
        "properties": {
          "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "extension_prefix": {"const": "x"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "namespace", "status", "summary", "semantics", "introduced_in_rcl"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
          "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "status": {"type": "string", "enum": ["experimental", "stable", "deprecated"]},
          "summary": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "introduced_in_rcl": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "replaced_by": {"type": ["string", "null"]}
        }
      }
    }
  }
}
