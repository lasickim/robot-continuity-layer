{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:expression-optimization-candidate",
  "title": "RCL Expression Optimization Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_version", "candidate_id", "created_at", "behavior_id", "current_expression_sha256", "action", "reason", "evidence_refs", "replacement_expression"],
  "properties": {
    "candidate_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "behavior_id": {"type": "string", "minLength": 1},
    "current_expression_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {"type": "string", "enum": ["simplify", "remove"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "replacement_expression": {"type": ["object", "null"]}
  }
}
