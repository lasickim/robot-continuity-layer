{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.3:session-manifest",
  "title": "RCL Repeated-Session Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_manifest_version", "confidence_level", "min_sessions", "sessions"],
  "properties": {
    "session_manifest_version": {"const": "0.1"},
    "confidence_level": {"const": 0.95},
    "min_sessions": {"type": "integer", "minimum": 3},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "source_trials", "target_trials"],
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "source_trials": {"type": "string", "minLength": 1},
          "target_trials": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
