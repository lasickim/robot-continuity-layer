{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-conformance-report",
  "title": "RCL Intent-aware Adapter Conformance Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rcl_version",
    "suite_id",
    "suite_version",
    "created_at",
    "adapter",
    "passed",
    "compatibility_level",
    "groups",
    "checks",
    "disclaimer"
  ],
  "properties": {
    "rcl_version": {"const": "0.2"},
    "suite_id": {"const": "rcl.adapter.intent.v0.4"},
    "suite_version": {"const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "python_class"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "python_class": {"type": "string", "minLength": 1}
      }
    },
    "passed": {"type": "boolean"},
    "compatibility_level": {
      "type": ["string", "null"],
      "enum": ["RCL Intent Migration Compatible", null]
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Profile", "Adapter", "Intent", "Paths", "Safety", "Reporting"],
      "properties": {
        "Profile": {"type": "boolean"},
        "Adapter": {"type": "boolean"},
        "Intent": {"type": "boolean"},
        "Paths": {"type": "boolean"},
        "Safety": {"type": "boolean"},
        "Reporting": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "check_id", "passed", "message"],
        "properties": {
          "group": {
            "type": "string",
            "enum": ["Profile", "Adapter", "Intent", "Paths", "Safety", "Reporting"]
          },
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
