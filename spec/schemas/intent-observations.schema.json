{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-observations",
  "title": "RCL Intent Observation Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_observation_version", "robot_id", "embodiment_id", "captured_at", "intent_observations"],
  "properties": {
    "intent_observation_version": {"const": "0.1"},
    "robot_id": {"type": "string", "minLength": 1},
    "embodiment_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "intent_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "behavior_id", "trigger", "trigger_state", "success_condition", "success_state"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "behavior_id": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "trigger_state": {"type": "string", "enum": ["observed", "not_observed"]},
          "success_condition": {"type": "string", "minLength": 1},
          "success_state": {"type": "string", "enum": ["satisfied", "not_satisfied", "not_observable"]},
          "strategy_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
