{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcl:schema:v0.4:intent-revision-patch",
  "title": "RCL Intent Revision Patch v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_version",
    "method",
    "behavior_id",
    "approved_at",
    "approved_by",
    "source_profile",
    "source_behavior_sha256",
    "candidate",
    "before_intent",
    "after_intent",
    "history_entry"
  ],
  "properties": {
    "revision_version": {"const": "0.1"},
    "method": {"const": "rcl.intent.revision.patch.v0.1"},
    "behavior_id": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": ["string", "null"]},
    "source_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robot_id", "continuity_generation", "embodiment_id"],
      "properties": {
        "robot_id": {"type": "string", "minLength": 1},
        "continuity_generation": {"type": "integer", "minimum": 1},
        "embodiment_id": {"type": "string", "minLength": 1}
      }
    },
    "source_behavior_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "created_at", "candidate_sha256", "reason", "evidence_refs", "causal_claim"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "causal_claim": {"const": false}
      }
    },
    "before_intent": {"type": "object"},
    "after_intent": {"type": "object"},
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revised_at",
        "revised_by",
        "candidate_id",
        "candidate_sha256",
        "reason",
        "evidence_refs",
        "from_intent_sha256",
        "to_intent_sha256",
        "intent_snapshot",
        "causal_claim"
      ],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "revised_at": {"type": "string", "format": "date-time"},
        "revised_by": {"type": ["string", "null"]},
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "from_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "to_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "intent_snapshot": {"type": "object"},
        "causal_claim": {"const": false}
      }
    }
  }
}
