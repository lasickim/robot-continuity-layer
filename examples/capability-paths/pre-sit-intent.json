{
  "goal_id": "safety.verify_sitting_area_clear",
  "description": "Verify the intended sitting area without requiring one embodiment-specific sensing recipe.",
  "trigger": "activity.before_sit_down",
  "success_condition": "state.sitting_area_clear",
  "failure_action": "block",
  "criticality": "required",
  "capability_paths": [
    {
      "path_id": "direct_clearance",
      "description": "Use a target capability that directly exposes sitting-area clearance.",
      "all_of": [
        "perception.sitting_area_clearance"
      ]
    },
    {
      "path_id": "rear_attention_classifier",
      "description": "Direct attention rearward and use one compatible semantic clearance estimator.",
      "all_of": [
        "perception.directional_attention"
      ],
      "any_of": [
        "x.demo.rear_clearance_classifier",
        "x.demo.rear_occupancy_estimator"
      ]
    },
    {
      "path_id": "external_seat_state",
      "description": "Select one external semantic source that reports seat-area clearance.",
      "one_of": [
        "x.demo.external_seat_clearance",
        "x.demo.networked_seat_clearance"
      ]
    }
  ],
  "constraints": [
    "safety.no_unverified_sit"
  ]
}
